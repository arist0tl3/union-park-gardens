---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
---

<BaseLayout title="Thank You" description="Thanks for submitting a photo to the Union Park Gardens archive.">
  <section class="page-header">
    <div class="section-inner">
      <SectionHeader eyebrow="Photo Archive" title="Photo<br /><em>received</em>" />
    </div>
  </section>

  <section class="community-page">
    <div class="thanks-section">
      <p>Thanks for sharing a piece of Union Park Gardens history! We're excited to take a look.</p>
      <p>We'll do our best to get back to you within 3 business days.</p>
      <a href="/archive" class="btn btn-dark">Back to archive</a>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks-section {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .thanks-section p {
    color: var(--warm-gray);
    font-size: 1.05rem;
    margin-bottom: 1.5rem;
  }
</style>
