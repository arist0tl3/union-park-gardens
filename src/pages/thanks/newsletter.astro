---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
---

<BaseLayout title="Thank You" description="Thanks for subscribing to the Union Park Gardens newsletter.">
  <section class="page-header">
    <div class="section-inner">
      <SectionHeader eyebrow="Newsletter" title="Thank<br /><em>you</em>" />
    </div>
  </section>

  <section class="community-page">
    <div class="thanks-section">
      <p>You're on the list! We'll send occasional updates about events, neighborhood news, and the photo archive.</p>
      <p>We'll do our best to get back to you within 3 business days if you have any questions.</p>
      <a href="/" class="btn btn-dark">Back to home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header + .community-page {
    padding-top: 1rem;
  }

  .thanks-section {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .thanks-section p {
    color: var(--warm-gray);
    font-size: 1.05rem;
    margin-bottom: 1.5rem;
  }
</style>
