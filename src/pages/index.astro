---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { FOOD_TRUCK } from '../config';

const now = new Date();
const allEvents = await getCollection('events');

const upcoming = allEvents
  .filter(e => e.data.date >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

// Most recent past event that has photos, for the homepage gallery
const recentWithPhotos = allEvents
  .filter(e => e.data.date < now && e.data.photos && e.data.photos.length > 0)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const recentPhotos = recentWithPhotos?.data.photos ?? [];

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });

const nextFoodTruck = FOOD_TRUCK.schedule[0];
const nextEvent = upcoming[0];
const foodTruckDays = FOOD_TRUCK.schedule.map(s => s.day).join(' & ');
const shortDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout>
  {(nextEvent || FOOD_TRUCK.schedule.length > 0) && (
    <a href="/events" class="home-banner">
      {nextEvent && (
        <span class="home-banner-item">
          <span class="home-banner-label">Next</span>
          {nextEvent.data.title} · {shortDate(nextEvent.data.date)}
        </span>
      )}
      {FOOD_TRUCK.schedule.length > 0 && (
        <span class="home-banner-item secondary">
          <span class="home-banner-label">Food Trucks</span>
          {foodTruckDays}
        </span>
      )}
      <span class="home-banner-cta">View all &rarr;</span>
    </a>
  )}

  <Hero
    eyebrow="Wilmington, Delaware · Est. 1918"
    title="Union Park<br /><em>Gardens</em>"
    subtitle="A neighborhood built in a year, for workers who built a fleet. A community that has endured for more than a century."
    backgroundImage="/images/hero-map.jpg"
  />

  <!-- WHAT'S HAPPENING -->
  <section class="happening-section" id="happening">
    <div class="section-inner">
      <SectionHeader eyebrow="In the Neighborhood" title="What's <em>happening</em>" />

      {nextFoodTruck && (
        <a href="/events" class="foodtruck-strip">
          <span class="foodtruck-strip-tag">Food Truck</span>
          <span class="foodtruck-strip-body">
            <strong>{nextFoodTruck.day}s</strong> · {nextFoodTruck.vendor} · {nextFoodTruck.time}
          </span>
          <span class="foodtruck-strip-cta">Full schedule &rarr;</span>
        </a>
      )}

      {upcoming.length > 0 && (
        <div class="upcoming-home">
          {upcoming.slice(0, 2).map(event => (
            <div class="upcoming-card">
              <div class="upcoming-date">
                {formatDate(event.data.date)}
                {event.data.time && ` · ${event.data.time}`}
              </div>
              <h3>{event.data.title}</h3>
              {event.data.location && <p class="upcoming-location">{event.data.location}</p>}
            </div>
          ))}
        </div>
      )}

      <div style="text-align:center;margin-top:2.5rem">
        <Button href="/events" label="See all events" variant="dark" />
      </div>
    </div>
  </section>

  <!-- RECENT PHOTOS -->
  {recentPhotos.length > 0 && (
    <section class="photos-section" id="photos">
      <div class="section-inner" style="max-width:960px">
        <SectionHeader eyebrow="From the Neighborhood" title="<em>Recently</em> in UPG" />
        <p style="text-align:center;color:var(--warm-gray);font-style:italic;margin-top:-1rem;margin-bottom:2.5rem">
          {recentWithPhotos.data.title}
        </p>
        <div class="home-gallery">
          <a href="/events" class="home-gallery-main">
            <Image src={recentPhotos[0].src} alt={recentPhotos[0].alt} widths={[600, 1200]} sizes="(min-width: 720px) 720px, 100vw" />
          </a>
          {recentPhotos.length > 1 && (
            <div class="home-gallery-thumbs">
              {recentPhotos.slice(1, 3).map(photo => (
                <a href="/events" class="home-gallery-thumb">
                  <Image src={photo.src} alt={photo.alt} widths={[300, 600]} sizes="(min-width: 720px) 360px, 50vw" />
                </a>
              ))}
            </div>
          )}
        </div>
        <div style="text-align:center;margin-top:2.5rem">
          <Button href="/events" label="See more photos" variant="dark" />
        </div>
      </div>
    </section>
  )}

  <!-- HISTORY TEASER -->
  <section class="intro" id="about">
    <div class="section-inner">
      <SectionHeader
        eyebrow="About the Neighborhood"
        title="Built in wartime haste,<br /><em>standing</em> a century later"
      />
      <p class="lead">
        In 1918, with America at war and Wilmington's shipyards running at full capacity, an entire neighborhood was designed, built, and occupied in under a year — conceived by renowned planner John Nolen as a true community, not mere worker housing.
      </p>
      <p>
        More than a century later, the brick row houses, the tree-lined parkway, and the close-knit streets remain very much intact.
      </p>
      <div style="text-align:center;margin-top:2rem">
        <Button href="/history" label="Read the full history" variant="dark" />
      </div>
    </div>
  </section>

  <!-- COMMUNITY CTA -->
  <section class="community-section" id="community">
    <div class="section-inner">
      <SectionHeader
        eyebrow="Get Involved"
        title="This is <em>your</em> neighborhood"
        variant="dark"
      />
      <p>
        Whether you've lived here for decades or just moved in, there's a place for you in this community — cleanups, the council, the newsletter, and more.
      </p>
      <div class="cta-group">
        <Button href="/community" label="Get involved" variant="light" />
        <Button href="mailto:unionparkgardens@gmail.com" label="Get in touch" variant="light" />
      </div>
    </div>
  </section>
</BaseLayout>

<!-- Home-only: shift the fixed nav down so the announcement banner sits above it -->
<style is:global>
  nav { top: 2.6rem; }
</style>

<style>
  .home-banner {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    height: 2.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 0 1.5rem;
    background: var(--stone);
    color: var(--cream);
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    overflow: hidden;
    white-space: nowrap;
  }

  .home-banner-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .home-banner-label {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper);
    background: rgba(245, 242, 236, 0.16);
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .home-banner-cta {
    color: var(--light-gray);
    flex-shrink: 0;
  }

  .home-banner:hover .home-banner-cta {
    color: var(--paper);
  }

  .home-gallery {
    margin-top: 3rem;
  }

  .home-gallery-main,
  .home-gallery-thumb {
    display: block;
    overflow: hidden;
    line-height: 0;
  }

  /* Main photo keeps its natural aspect ratio */
  .home-gallery-main :global(img) {
    width: 100%;
    height: auto;
    filter: grayscale(100%);
    transition: filter 0.4s ease, transform 0.4s ease;
  }

  /* Thumbnails crop uniformly so the row stays even */
  .home-gallery-thumbs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 1rem;
  }

  .home-gallery-thumb :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.4s ease, transform 0.4s ease;
  }

  .home-gallery-main:hover :global(img),
  .home-gallery-thumb:hover :global(img) {
    filter: grayscale(50%);
    transform: scale(1.03);
  }

  .happening-section {
    background: var(--paper);
  }

  .foodtruck-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    max-width: 680px;
    margin: 0 auto 2.5rem;
    padding: 1rem 1.5rem;
    border: 1px solid var(--parchment);
    background: var(--cream);
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .foodtruck-strip:hover {
    border-color: var(--light-gray);
  }

  .foodtruck-strip-tag {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ash);
    padding: 0.25rem 0.6rem;
  }

  .foodtruck-strip-body {
    flex: 1;
    color: var(--slate);
    font-size: 0.95rem;
  }

  .foodtruck-strip-body strong {
    color: var(--stone);
  }

  .foodtruck-strip-cta {
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--warm-gray);
  }

  .upcoming-home {
    max-width: 680px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .upcoming-card {
    padding: 1.75rem;
    border: 1px solid var(--parchment);
  }

  .upcoming-date {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm-gray);
    margin-bottom: 0.5rem;
  }

  .upcoming-card h3 {
    font-family: var(--serif-display);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--stone);
    margin: 0 0 0.35rem;
  }

  .upcoming-location {
    font-size: 0.85rem;
    color: var(--warm-gray);
    margin: 0;
  }

  @media (max-width: 700px) {
    .upcoming-home {
      grid-template-columns: 1fr;
    }
    .foodtruck-strip {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 600px) {
    .home-banner {
      gap: 1rem;
      font-size: 0.72rem;
    }
    .home-banner-item.secondary {
      display: none;
    }
  }
</style>
