---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { FOOD_TRUCK } from '../config';

const now = new Date();
const allEvents = await getCollection('events');

const upcoming = allEvents
  .filter(e => e.data.date >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

// Most recent past event that has photos, for the homepage gallery
const recentWithPhotos = allEvents
  .filter(e => e.data.date < now && e.data.photos && e.data.photos.length > 0)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const recentPhotos = recentWithPhotos?.data.photos ?? [];

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });

const nextFoodTruck = FOOD_TRUCK.schedule[0];
---

<BaseLayout>
  <Hero
    eyebrow="Wilmington, Delaware · Est. 1918"
    title="Union Park<br /><em>Gardens</em>"
    subtitle="A neighborhood built in a year, for workers who built a fleet. A community that has endured for more than a century."
    backgroundImage="/images/hero-map.jpg"
  />

  <!-- WHAT'S HAPPENING -->
  <section class="happening-section" id="happening">
    <div class="section-inner">
      <SectionHeader eyebrow="In the Neighborhood" title="What's <em>happening</em>" />

      {nextFoodTruck && (
        <a href="/events" class="foodtruck-strip">
          <span class="foodtruck-strip-tag">Food Truck</span>
          <span class="foodtruck-strip-body">
            <strong>{nextFoodTruck.day}s</strong> · {nextFoodTruck.vendor} · {nextFoodTruck.time}
          </span>
          <span class="foodtruck-strip-cta">Full schedule &rarr;</span>
        </a>
      )}

      {upcoming.length > 0 && (
        <div class="upcoming-home">
          {upcoming.slice(0, 2).map(event => (
            <div class="upcoming-card">
              <div class="upcoming-date">
                {formatDate(event.data.date)}
                {event.data.time && ` · ${event.data.time}`}
              </div>
              <h3>{event.data.title}</h3>
              {event.data.location && <p class="upcoming-location">{event.data.location}</p>}
            </div>
          ))}
        </div>
      )}

      <div style="text-align:center;margin-top:2.5rem">
        <Button href="/events" label="See all events" variant="dark" />
      </div>
    </div>
  </section>

  <!-- RECENT PHOTOS -->
  {recentPhotos.length > 0 && (
    <section class="photos-section" id="photos">
      <div class="section-inner" style="max-width:960px">
        <SectionHeader eyebrow="From the Neighborhood" title="<em>Recently</em> in UPG" />
        <p style="text-align:center;color:var(--warm-gray);font-style:italic;margin-top:-1rem;margin-bottom:2.5rem">
          {recentWithPhotos.data.title}
        </p>
        <div class="photo-grid">
          {recentPhotos.slice(0, 3).map(photo => (
            <div class="photo-item">
              <Image src={photo.src} alt={photo.alt} widths={[400, 800]} sizes="(min-width: 720px) 460px, 100vw" />
            </div>
          ))}
        </div>
        <div style="text-align:center;margin-top:2.5rem">
          <Button href="/events" label="See more photos" variant="dark" />
        </div>
      </div>
    </section>
  )}

  <!-- HISTORY TEASER -->
  <section class="intro" id="about">
    <div class="section-inner">
      <SectionHeader
        eyebrow="About the Neighborhood"
        title="Built in wartime haste,<br /><em>standing</em> a century later"
      />
      <p class="lead">
        In 1918, with America at war and Wilmington's shipyards running at full capacity, an entire neighborhood was designed, built, and occupied in under a year — conceived by renowned planner John Nolen as a true community, not mere worker housing.
      </p>
      <p>
        More than a century later, the brick row houses, the tree-lined parkway, and the close-knit streets remain very much intact.
      </p>
      <div style="text-align:center;margin-top:2rem">
        <Button href="/history" label="Read the full history" variant="dark" />
      </div>
    </div>
  </section>

  <!-- COMMUNITY CTA -->
  <section class="community-section" id="community">
    <div class="section-inner">
      <SectionHeader
        eyebrow="Get Involved"
        title="This is <em>your</em> neighborhood"
        variant="dark"
      />
      <p>
        Whether you've lived here for decades or just moved in, there's a place for you in this community — cleanups, the council, the newsletter, and more.
      </p>
      <div class="cta-group">
        <Button href="/community" label="Get involved" variant="light" />
        <Button href="mailto:unionparkgardens@gmail.com" label="Get in touch" variant="light" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .happening-section {
    background: var(--paper);
  }

  .foodtruck-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    max-width: 680px;
    margin: 0 auto 2.5rem;
    padding: 1rem 1.5rem;
    border: 1px solid var(--parchment);
    background: var(--cream);
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .foodtruck-strip:hover {
    border-color: var(--light-gray);
  }

  .foodtruck-strip-tag {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ash);
    padding: 0.25rem 0.6rem;
  }

  .foodtruck-strip-body {
    flex: 1;
    color: var(--slate);
    font-size: 0.95rem;
  }

  .foodtruck-strip-body strong {
    color: var(--stone);
  }

  .foodtruck-strip-cta {
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    color: var(--warm-gray);
  }

  .upcoming-home {
    max-width: 680px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .upcoming-card {
    padding: 1.75rem;
    border: 1px solid var(--parchment);
  }

  .upcoming-date {
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--warm-gray);
    margin-bottom: 0.5rem;
  }

  .upcoming-card h3 {
    font-family: var(--serif-display);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--stone);
    margin: 0 0 0.35rem;
  }

  .upcoming-location {
    font-size: 0.85rem;
    color: var(--warm-gray);
    margin: 0;
  }

  @media (max-width: 700px) {
    .upcoming-home {
      grid-template-columns: 1fr;
    }
    .foodtruck-strip {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
